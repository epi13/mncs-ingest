mncs 0.13;

// mncs.ingest.handoff.v1 — typed handoff contract for downstream Store.
//
// This record is deliberately generic. Ingest preserves source and
// transformation identities and carries bounded completeness/limitation
// states; it does not decide Commons pressure lifecycle or any sibling's
// domain meaning.
//
// Fixed transport representation (164 bytes):
//   IH1\0 | semantic_type | source_kind | completeness | lossiness |
//   source identity | semantic identity | producer identity |
//   transformation identity
module mncs.ingest.handoff;

record Handoff {
    semantic_type: u64,
    source_kind: u64,
    completeness: u64,
    lossiness: u64,
    source_identity: [byte; 32],
    semantic_identity: [byte; 32],
    producer_identity: [byte; 32],
    transformation_identity: [byte; 32]
}

// Status vocabulary: 0 complete, 1 partial, 2 unknown, 3 unsupported,
// 4 lossy. The function only classifies the bounded ingest facts; it does
// not invent a semantic value for an unknown object.
fn object_status(object_code: i64) -> (result: u64) {
    if object_code == 1 || object_code == 2 { return 0; }
    if object_code == 0 { return 2; }
    return 3;
}

fn canonical_status(object_code: i64, quantity_present: bool) -> (result: u64) {
    let base: u64 = object_status(object_code);
    if base == 0 && quantity_present { return 0; }
    if base == 0 { return 1; }
    return base;
}

fn u64_bytes(value: u64) -> (result: [byte; 8]) {
    let b0: byte = (value / 72057594037927936) as byte;
    let r0: u64 = value % 72057594037927936;
    let b1: byte = (r0 / 281474976710656) as byte;
    let r1: u64 = r0 % 281474976710656;
    let b2: byte = (r1 / 1099511627776) as byte;
    let r2: u64 = r1 % 1099511627776;
    let b3: byte = (r2 / 4294967296) as byte;
    let r3: u64 = r2 % 4294967296;
    let b4: byte = (r3 / 16777216) as byte;
    let r4: u64 = r3 % 16777216;
    let b5: byte = (r4 / 65536) as byte;
    let r5: u64 = r4 % 65536;
    let b6: byte = (r5 / 256) as byte;
    let b7: byte = (r5 % 256) as byte;
    return [b0, b1, b2, b3, b4, b5, b6, b7];
}

fn copy8(out: [byte; 164], offset: u64, value: [byte; 8]) -> (result: [byte; 164]) {
    iterate i over value carrying row: [byte; 164] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn copy32(out: [byte; 164], offset: u64, value: [byte; 32]) -> (result: [byte; 164]) {
    iterate i over value carrying row: [byte; 164] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn encode(value: Handoff) -> (result: [byte; 164]) {
    let seed: [byte; 164] = [0; 164];
    let tagged: [byte; 164] = replace(replace(replace(replace(seed,
        0, 73), 1, 72), 2, 1), 3, 0);
    let s: [byte; 164] = copy8(tagged, 4, u64_bytes(value.semantic_type));
    let sk: [byte; 164] = copy8(s, 12, u64_bytes(value.source_kind));
    let c: [byte; 164] = copy8(sk, 20, u64_bytes(value.completeness));
    let l: [byte; 164] = copy8(c, 28, u64_bytes(value.lossiness));
    let si: [byte; 164] = copy32(l, 36, value.source_identity);
    let mi: [byte; 164] = copy32(si, 68, value.semantic_identity);
    let pi: [byte; 164] = copy32(mi, 100, value.producer_identity);
    return copy32(pi, 132, value.transformation_identity);
}

fn validate(view: [byte; up_to 164]) -> (result: u64) {
    if view.len != 164 { return 1; }
    if view[0] != 73 || view[1] != 72 { return 2; }
    if view[2] != 1 { return 3; }
    if view[3] != 0 { return 4; }
    return 0;
}

fn encode_fields(semantic_type_value: u64, source_kind_value: u64, completeness_value: u64, lossiness_value: u64, source_value: [byte; 32], semantic_value: [byte; 32], producer_value: [byte; 32], transformation_value: [byte; 32]) -> (result: [byte; 164]) {
    return encode(Handoff {
        semantic_type: semantic_type_value,
        source_kind: source_kind_value,
        completeness: completeness_value,
        lossiness: lossiness_value,
        source_identity: source_value,
        semantic_identity: semantic_value,
        producer_identity: producer_value,
        transformation_identity: transformation_value
    });
}
