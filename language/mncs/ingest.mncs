mncs 0.13;

// mncs.ingest — facade root compiled and executed by the host runtime.
//
// This module owns no policy of its own; it binds the vocabulary,
// parser, and frame decisions into the single program the host loads,
// so every ingest verdict executes through one stable entry surface.
// Policy lives in `mncs.ingest.vocab`, `mncs.ingest.parse`, and
// `mncs.ingest.frame`.
module mncs.ingest;

use mncs.ingest.vocab as vocab;
use mncs.ingest.parse as parse;
use mncs.ingest.frame as frame;
use mncs.ingest.handoff as handoff;
use mncs.flow.lines as lines;
use mncs.flow.fields as fields;
use mncs.flow.frames as frames;
use mncs.flow.nest as nest;
use mncs.flow.manifest as manifest;

// Bounded text path: raw sentence bytes in, canonical role spans out.
fn ingest_parse(text: [byte; up_to 64], length: u64) -> (result: parse.TransferParse) {
    return parse.parse_transfer(text, length);
}

// Structured/native path: classify the event spelling; the host passes
// one word with start 0 through the same span-based tables.
fn ingest_classify_event(word: [byte; up_to 64], length: u64) -> (result: i64) {
    return vocab.classify_event(word, 0, length);
}

fn ingest_classify_object(word: [byte; up_to 64], length: u64) -> (result: i64) {
    return vocab.classify_object(word, 0, length);
}

fn ingest_object_status(object_code: i64) -> (result: i64) {
    return handoff.object_status(object_code) as i64;
}

fn ingest_object_spelling_matches(word: [byte; up_to 64], length: u64, object_code: i64) -> (result: i64) {
    return select(vocab.object_spelling_matches(word, 0, length, object_code), 1, 0);
}

fn ingest_canonical_status(object_code: i64, quantity_present: bool) -> (result: i64) {
    return handoff.canonical_status(object_code, quantity_present) as i64;
}

fn ingest_handoff_encode(semantic_type: u64, source_kind: u64, completeness: u64, lossiness: u64, source_identity: [byte; 32], semantic_identity: [byte; 32], producer_identity: [byte; 32], transformation_identity: [byte; 32]) -> (result: [byte; 164]) {
    return handoff.encode_fields(semantic_type, source_kind, completeness, lossiness, source_identity, semantic_identity, producer_identity, transformation_identity);
}

// Structured/native path: validate extracted fields.
fn ingest_validate(event: i64, src_present: bool, tgt_present: bool, qty_present: bool, qty: i64) -> (result: i64) {
    return frame.validate_structured(event, src_present, tgt_present, qty_present, qty);
}

// Equality path: closed-vocabulary codes compare here; open-vocabulary
// spellings compare through `ingest_spell_equal`. Both verdicts must
// agree for two fragments to be semantically equal.
fn ingest_codes_equal(a_event: i64, a_object: i64, a_qty_present: bool, a_qty: i64, b_event: i64, b_object: i64, b_qty_present: bool, b_qty: i64) -> (result: i64) {
    return frame.codes_equal(a_event, a_object, a_qty_present, a_qty, b_event, b_object, b_qty_present, b_qty);
}

fn ingest_spell_equal(a: [byte; up_to 64], a_length: u64, b: [byte; up_to 64], b_length: u64) -> (result: i64) {
    return frame.spell_equal(a, a_length, b, b_length);
}

// Ordering path: deterministic sort and its orderedness witness over
// atom-code projections.
fn ingest_sort_codes(xs: [u64; 8], count: u64) -> (result: [u64; 8]) {
    return frame.sort_codes(xs, count);
}

fn ingest_is_sorted(xs: [u64; 8], count: u64) -> (result: i64) {
    return frame.is_sorted_codes(xs, count);
}

// Streaming line path: one chunk in, at most one line plus carry out.
// The host windows the stream into <=256-byte views; every boundary,
// validation, and cursor decision executes here.
fn ingest_next_line(carry: [byte; 256], carry_len: u64, view: [byte; up_to 256], view_len: u64, eof: bool) -> (result: lines.LineOut) {
    return lines.next_line(carry, carry_len, view, view_len, eof);
}

// Streaming field path: unescape one field starting at `start`.
fn ingest_field_at(line: [byte; 256], line_len: u64, start: u64) -> (result: fields.FieldOut) {
    return fields.field_at(line, line_len, start);
}

// Streaming binary-frame path: stage carry plus one chunk view.
fn ingest_decode_frame(carry: [byte; 136], carry_len: u64, view: [byte; up_to 256], view_len: u64, eof: bool) -> (result: frames.FrameOut) {
    return frames.decode_frame(carry, carry_len, view, view_len, eof);
}

// Incremental manifest scan: records cannot cross into calls without a
// forged type identity, so scanner state decomposes into scalar lanes
// (INGEST-P-009); the state record is rebuilt inside.
fn ingest_scan_chunk(depth: u64, stack: [u64; 4], expect: u64, in_string: bool, esc: bool, max_depth: u64, seen_value: bool, in_literal: bool, after_comma: bool, view: [byte; up_to 256], view_len: u64, base: u64, eof: bool) -> (result: nest.ScanOut) {
    let state: nest.NestState = nest.NestState {
        depth: depth,
        stack: stack,
        expect: expect,
        in_string: in_string,
        esc: esc,
        max_depth: max_depth,
        seen_value: seen_value,
        in_literal: in_literal,
        after_comma: after_comma
    };
    return nest.scan_chunk(state, view, view_len, base, eof);
}

// Manifest extraction over staged bytes of a complete document.
fn ingest_pair_count(doc: [byte; 512], doc_len: u64) -> (result: i64) {
    return manifest.pair_count(doc, doc_len);
}

fn ingest_pair_at(doc: [byte; 512], doc_len: u64, index: u64) -> (result: manifest.PairOut) {
    return manifest.pair_at(doc, doc_len, index);
}

// Diagnostics entry point: exposes splitter/classifier internals as
// plain integers [count, verb_idx, verb_count, c0, c1, c2, c3, c4] so
// host tests can pin the interpretation pipeline stage by stage.
fn ingest_debug(text: [byte; up_to 64], length: u64) -> (result: [i64; 8]) {
    let tlen: u64 = select(length <= text.len, length, text.len);
    let eff: u64 = parse.effective_length(text, tlen);
    let split: parse.SplitState = parse.split_words(text, eff);
    let cls: parse.ClassState = parse.classify_all(text, split);
    return [split.count as i64, cls.verb_idx, cls.verb_count as i64, cls.classes[0], cls.classes[1], cls.classes[2], cls.classes[3], cls.classes[4]];
}
